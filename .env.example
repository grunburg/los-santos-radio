# Where the station files are served from, with or without a trailing slash.
# Leave unset to use stations/ next to the app (the default).
#VITE_STATIONS_URL=https://raw.githubusercontent.com/RegalTerritory/GTA-V-Radio-Stations/b08529c7b1362f7f83c5f7144887123e630e2569

# Set to true to show the debug panel with the schedule position.
VITE_DEBUG=false

# A time API to set the clock by, so every device plays the same thing. Leave unset to trust the
# device's clock. The API is asked for VITE_TIMEZONE, which the debug panel also shows the clock in.
VITE_TIME_API_URL=https://time.now/developer/api/timezone
VITE_TIMEZONE=Europe/Riga
